# Same database and login as the admin API (kiran_book_center_admin_config).
DB_SERVER=localhost
DB_DATABASE=KiranBookCenter
DB_USER=
# Put the password in double quotes if it contains # (dotenv treats # as a comment).
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=false

# Customer sessions: a long random secret (at least 32 characters), different from ADMIN_AUTH_SECRET.
CUSTOMER_AUTH_SECRET=
CUSTOMER_TOKEN_TTL_SECONDS=2592000

# Uploaded files. Both APIs must use the SAME store so the shop can show photos the owner uploads:
# either FILE_STORE=db on both, or the same UPLOAD_DIR folder on both.
FILE_STORE=
UPLOAD_DIR=

# Comma-separated web addresses allowed to call this API (the shop website). Empty = any (local only).
CORS_ORIGINS=
PORT=5100
